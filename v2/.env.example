# Trusted shell environment file: copy outside Git, chmod 600, fill, then export.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Same-origin requests need no extra trusted origin. Comma-separated HTTPS origins.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_HTTPS=0

SPACE_BOXES_DB_NAME=space_boxes_v2
SPACE_BOXES_DB_USER=spaceboxes
SPACE_BOXES_DB_PASSWORD=
SPACE_BOXES_DB_HOST=127.0.0.1
SPACE_BOXES_DB_PORT=5434
SPACE_BOXES_DB_SSLMODE=require

SPACE_BOXES_EMAIL_HOST=
SPACE_BOXES_EMAIL_PORT=587
SPACE_BOXES_EMAIL_USER=
SPACE_BOXES_EMAIL_PASSWORD=
SPACE_BOXES_EMAIL_USE_TLS=1
SPACE_BOXES_EMAIL_USE_SSL=0
SPACE_BOXES_FROM_EMAIL=

SPACE_BOXES_BIND=127.0.0.1:8000
SPACE_BOXES_WORKERS=2
# Optional local TLS; supply both absolute paths, or use a trusted TLS proxy.
SPACE_BOXES_TLS_CERT=
SPACE_BOXES_TLS_KEY=
