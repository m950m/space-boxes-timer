# Names/defaults only. Create a private copy for an ISOLATED staging service.
# Never copy values from space-boxes-bdd48 or connect to the current space-boxes DB.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
SPACE_BOXES_PUBLIC_WEB_URL=
# Enable trusted proxy headers only after confirming the HTTPS edge overwrites them.
DJANGO_TRUST_PROXY_HTTPS=0
DJANGO_SSL_REDIRECT=1
SPACE_BOXES_DB_NAME=postgres
SPACE_BOXES_DB_HOST=
SPACE_BOXES_DB_PORT=5432
SPACE_BOXES_DB_USER=
SPACE_BOXES_DB_PASSWORD=
SPACE_BOXES_DB_SSLMODE=require
# Prefer verify-full plus PGSSLROOTCERT when the provider CA is mounted.
SPACE_BOXES_EMAIL_HOST=smtp-relay.brevo.com
SPACE_BOXES_EMAIL_PORT=2525
SPACE_BOXES_EMAIL_USER=
SPACE_BOXES_EMAIL_PASSWORD=
SPACE_BOXES_EMAIL_USE_TLS=1
SPACE_BOXES_EMAIL_USE_SSL=0
SPACE_BOXES_FROM_EMAIL=
SPACE_BOXES_BIND=0.0.0.0:8000
SPACE_BOXES_WORKERS=2
